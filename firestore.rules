rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Display names
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
    }

    // Invite codes -> group id. Anyone signed in can look up a code they were given.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.unlockAt is timestamp
        && request.resource.data.unlockAt > request.time;

      // The only allowed change: someone adding themselves to members (joining with a code).
      // The unlock date can never be changed.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.size() <= 50;

      allow delete: if false;

      // Snap records (who sent what, when). The media itself lives in Storage and is locked there.
      match /snaps/{sid} {
        function grp() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        allow read: if signedIn() && request.auth.uid in grp().members;
        allow create: if signedIn()
          && request.auth.uid in grp().members
          && request.time < grp().unlockAt
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.kind in ['image', 'video']
          && request.resource.data.path is string;
        allow update, delete: if false;
      }

      // Text chat in the group: visible right away to members.
      match /msgs/{mid} {
        function grp2() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        allow read: if signedIn() && request.auth.uid in grp2().members;
        allow create: if signedIn()
          && request.auth.uid in grp2().members
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }
  }
}
